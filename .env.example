# AI API Key (Required)
AI_BAILIAN_API_KEY=your_api_key_here

# AI Model (Optional, default: qwen-plus)
# AI_MODEL=qwen-max
# Structured output retries (Optional, default: 2)
# APP_AI_STRUCTURED_MAX_ATTEMPTS=2
# Include last parser error in retry prompt (Optional, default: true)
# APP_AI_STRUCTURED_INCLUDE_LAST_ERROR=true

# RAG Hybrid Search (Optional, default: true)
# APP_AI_RAG_HYBRID_ENABLED=true
# APP_AI_RAG_HYBRID_RECALL_PER_PATH=30
# APP_AI_RAG_HYBRID_RECALL_TOPK=30
# APP_AI_RAG_HYBRID_FINAL_TOP_N=5
# APP_AI_RAG_HYBRID_RRF_K=60

# RAG Rerank (Optional, default: true, depends on hybrid enabled)
# APP_AI_RAG_RERANK_ENABLED=true
# APP_AI_RAG_RERANK_MODEL=qwen3-rerank
# APP_AI_RAG_RERANK_FINAL_TOP_N=5
# APP_AI_RAG_RERANK_MIN_CANDIDATES=8
# APP_AI_RAG_RERANK_SKIP_SHORT_QUERY=true
# APP_AI_RAG_RERANK_SHORT_QUERY_THRESHOLD=6

# Optional: Override defaults
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=interview_guide
